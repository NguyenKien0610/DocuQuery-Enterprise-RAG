GOOGLE_API_KEY=your_gemini_key_here
DOCUQUERY_API_KEY=replace_with_a_long_random_value
DOCUQUERY_WORKSPACE_ID=default
# The legacy key grants owner access ONLY to the workspace above.
# Optional JSON grants replace legacy authentication (use distinct random keys):
# DOCUQUERY_CREDENTIALS='[{"key":"reader-secret","workspaces":{"default":"reader"}},{"key":"owner-secret","workspaces":{"default":"owner"}}]'
# Roles: reader (read/query), writer (+upload), owner (+reset/reconcile).
# Workspace IDs use lowercase letters, digits, underscores and hyphens.
DOCUQUERY_API_BASE_URL=http://localhost:8000

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=docuquery_dense_v1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Optional host port overrides for Docker; internal service ports stay unchanged.
REDIS_PUBLISHED_PORT=6379
QDRANT_PUBLISHED_PORT=6333
API_PUBLISHED_PORT=8000
FRONTEND_PUBLISHED_PORT=8501
UPLOAD_DIR=uploads

RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
GEMINI_CHAT_MODEL=models/gemini-3.5-flash

MAX_UPLOAD_BYTES=26214400
MAX_EXTRACTED_BYTES=104857600
MAX_WORKSPACE_BYTES=268435456
MAX_WORKSPACE_DOCUMENTS=100
MAX_REQUESTS_PER_MINUTE=120
MAX_DOCUMENT_CHUNKS=512
MAX_DOCUMENT_PAGES=200
MAX_PARSED_BYTES=8388608
DOCUMENT_PARSE_TIMEOUT_SECONDS=60
DOCUMENT_PROCESS_TIMEOUT_SECONDS=180
DOCUMENT_TASK_TTL_SECONDS=900
# OS locks have no lease expiry; API/worker must share a local uploads volume.
WORKSPACE_LOCK_BLOCKING_TIMEOUT_SECONDS=1
